# HomeAIAgent persistent machine configuration
# Canonical location: ~/.config/HomeAIAgent/gateway.env
# This file must survive project replacement.

P0_MODE=full
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8765
GATEWAY_PATH=/companion

# A6.0 Security Foundation. Keep observe during staged device rollout.
# off     = legacy behavior, no authentication checks
# observe = record/challenge auth-capable devices but keep legacy clients working
# enforce = block unauthenticated clients; intentionally deployment-fused in A6.0
HOMEAI_SECURITY_MODE=observe
HOMEAI_SECURITY_ALLOW_ENFORCE=false
HOMEAI_SECURITY_CHALLENGE_TTL_SEC=10
HOMEAI_SECURITY_FAILURE_LIMIT=5
HOMEAI_SECURITY_FAILURE_WINDOW_SEC=60
HOMEAI_SECURITY_BLOCK_SEC=300
# Optional path overrides. Defaults live outside the project tree:
# ~/.config/HomeAIAgent/security/{devices.json,device_secrets.json}
# ~/.local/share/HomeAIAgent/security/security.log
# HOMEAI_SECURITY_DIR=
# HOMEAI_SECURITY_REGISTRY_FILE=
# HOMEAI_SECURITY_SECRETS_FILE=
# HOMEAI_SECURITY_AUDIT_LOG=

ASR_PROVIDER=volcengine
TTS_PROVIDER=volcengine
ASR_FALLBACK=none
TTS_FALLBACK=none

VOLCENGINE_API_KEY=

VOLCENGINE_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
VOLCENGINE_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
VOLCENGINE_ASR_CHUNK_MS=200
VOLCENGINE_ASR_SEND_INTERVAL_MS=100
VOLCENGINE_ASR_ENABLE_NONSTREAM=true
VOLCENGINE_ASR_END_WINDOW_MS=800
VOLCENGINE_ASR_FORCE_TO_SPEECH_MS=1000
VOLCENGINE_ASR_CONNECT_TIMEOUT=8
VOLCENGINE_ASR_FINAL_TIMEOUT=12

VOLCENGINE_TTS_ENDPOINT=wss://openspeech.bytedance.com/api/v3/tts/unidirectional/stream
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
VOLCENGINE_TTS_VOICE=zh_female_vv_uranus_bigtts
VOLCENGINE_TTS_SAMPLE_RATE=16000
VOLCENGINE_TTS_SPEECH_RATE=0
VOLCENGINE_TTS_LOUDNESS_RATE=0

# Long-TTS device-safe segmentation.
DEVICE_TTS_SEGMENT_MAX_BYTES=786432
DEVICE_TTS_PLAYBACK_MARGIN_SEC=15

OPENAI_API_KEY=

# Mini -> Air/OpenClaw
OPENCLAW_BASE_URL=http://127.0.0.1:18790
OPENCLAW_TOKEN=
OPENCLAW_MODEL=openclaw/default
OPENCLAW_USER=home-ai-agent:main
# Agent owning the stable voice session derived from OPENCLAW_USER.
OPENCLAW_VOICE_AGENT_ID=main

# Multi-device conversation routing.
# Current StickS3 has no device_id, so Gateway treats it as HOMEAI_PRIMARY_DEVICE_ID.
HOMEAI_PRIMARY_DEVICE_ID=homeai-agent-main-01
HOMEAI_MINI_DEVICE_ID=homeai-mini-bedroom-01
OPENCLAW_MINI_USER=home-ai-agent-mini:main

# Unknown future companion terminals are isolated automatically by device_id.
HOMEAI_AUTO_ISOLATE_UNKNOWN_COMPANIONS=true

# Optional explicit overrides for future companion devices. Reserved Main/Mini/
# Kitchen terminal mappings cannot be overridden or share one OpenClaw user.
# Example:
# HOMEAI_DEVICE_OPENCLAW_USERS_JSON={"desk-agent-01":"desk-agent:main"}

# Info Skill transient-session cleanup over OpenClaw Gateway RPC.
# No SSH login or remote CLI path is used by the cleanup path.
OPENCLAW_INFO_SESSION_CLEANUP=true
OPENCLAW_INFO_AGENT_ID=main
OPENCLAW_INFO_CLEANUP_TIMEOUT_SEC=20
# Optional. Default derives ws:// or wss:// from OPENCLAW_BASE_URL.
# OPENCLAW_GATEWAY_WS_URL=ws://127.0.0.1:18790
# OPENCLAW_GATEWAY_PROTOCOL=4
MAX_AGENT_CHARS=600

# Managed OpenClaw transport. HomeAIAgent owns the SSH forward in-process.
OPENCLAW_TRANSPORT=embedded_ssh
OPENCLAW_SSH_USER=
OPENCLAW_SSH_HOST=
OPENCLAW_LOCAL_PORT=18790
OPENCLAW_REMOTE_PORT=18789
OPENCLAW_SSH_CONNECT_TIMEOUT_SEC=10
OPENCLAW_SSH_RECONNECT_MIN_SEC=2
OPENCLAW_SSH_RECONNECT_MAX_SEC=30
OPENCLAW_SSH_STARTUP_WAIT_SEC=15

# HomeAIAgent Notification A1: outbound OpenClaw voice-session listener.
# Uses the managed OPENCLAW_BASE_URL transport; no reverse port or webhook.
HOMEAI_NOTIFICATION_LISTENER_ENABLED=true
HOMEAI_NOTIFICATION_HISTORY_LIMIT=60
HOMEAI_NOTIFICATION_RECONNECT_MIN_SEC=2
HOMEAI_NOTIFICATION_RECONNECT_MAX_SEC=30
HOMEAI_NOTIFICATION_SEEN_HISTORY=500
HOMEAI_REMINDER_RETRY_MAX_SEC=300

# KitchenTerminal: Obsidian dinner-menu source. Leave empty to use the built-in Path.home() default.
# New menus should use schema=kitchen-menu-v1.
# HOMEAI_KITCHEN_MENU_DIR=

# KitchenTerminal: Obsidian private-recipe destination.
# Default when omitted: sibling folder "私房菜" next to HOMEAI_KITCHEN_MENU_DIR.
# HOMEAI_KITCHEN_PRIVATE_RECIPE_DIR=
# Finished timer banners auto-prune after this many seconds; they can also be dismissed immediately on iPad.
# HOMEAI_KITCHEN_FINISHED_TIMER_TTL_SEC=1800

# Seconds to keep the "今天辛苦了" page before returning to idle.
HOMEAI_KITCHEN_IDLE_RETURN_DELAY_SEC=240

# KitchenTerminal Q&A. This is a third stable voice session, independent from
# Main HomeAgent and Agent Mini. Background Kitchen AI generation uses a separate
# tool user so it cannot pollute the Kitchen voice conversation.
# HOMEAI_KITCHEN_QA_MAX_SEC=25
HOMEAI_KITCHEN_OPENCLAW_USER=home-ai-kitchen:main
HOMEAI_KITCHEN_TOOL_OPENCLAW_USER=home-ai-kitchen-tool:main

# A5.0 selective no-wake follow-up. Only context-related follow-ups are accepted;
# unrelated speech is fail-closed and never enters the stable voice session.
HOMEAI_FOLLOWUP_TIMEOUT_SEC=10
HOMEAI_FOLLOWUP_AUDIO_FENCE_SEC=0.5
HOMEAI_FOLLOWUP_JUDGE_TIMEOUT_SEC=12
HOMEAI_FOLLOWUP_JUDGE_CLEANUP_TIMEOUT_SEC=2
HOMEAI_FOLLOWUP_LATCHED_ARRIVAL_GRACE_SEC=30
HOMEAI_FOLLOWUP_JUDGE_SESSION_CLEANUP=true

# Keep one spoken reply on the same NetworkSpeaker across a brief reconnect.
HOMEAI_AUDIO_ROUTE_RECONNECT_GRACE_SEC=8

# NetworkSpeaker transport profile (ESP32-C3 friendly defaults).
# NETWORK_SPEAKER_TTS_SEGMENT_MAX_BYTES=262144
# NETWORK_SPEAKER_TTS_CHUNK_BYTES=4096
# NETWORK_SPEAKER_TTS_PACE_EVERY_CHUNKS=8
# NETWORK_SPEAKER_TTS_PACE_SEC=0.001

# Default non-kitchen output routing: local / network.
# HOMEAI_DEFAULT_AUDIO_OUTPUT=network

# OpenClaw HTTP request budgets. Loopback traffic automatically bypasses
# HTTP(S)_PROXY / ALL_PROXY so a system-wide proxy cannot hijack the SSH tunnel.
OPENCLAW_CHAT_TIMEOUT_SEC=180
OPENCLAW_KITCHEN_TIMEOUT_SEC=180
OPENCLAW_INFO_TIMEOUT_SEC=300

# Logging: routine transport/UI chatter is quiet by default.
HOMEAI_LOG_VERBOSE=false
HOMEAI_LOG_TRACEBACK=false

# Gateway-side sleep ambient player. Dock firmware remains unchanged.
# Spoken examples: “播放雨声30分钟 / 播放雨夜爵士 / 换成海浪声 / 停止播放”.
HOMEAI_AMBIENT_DEFAULT_DURATION_SEC=3600
HOMEAI_AMBIENT_MAX_DURATION_SEC=28800
HOMEAI_AMBIENT_DEFAULT_VOLUME_PERCENT=5
# Real sleep-audio cache; install once with tools/fetch_ambient_assets.py
HOMEAI_AMBIENT_ASSET_DIR=~/.local/share/HomeAIAgent/ambient_assets
# 0.5-2.0 seconds. 1s keeps manual-stop/interruption latency low while the
# Dock's existing 64 KiB Jitter Buffer absorbs Wi-Fi jitter.
HOMEAI_AMBIENT_SEGMENT_SEC=1.0
# Prime both existing Dock playback slots before steady-state refill.
# Keep at 2 unless troubleshooting; no Dock firmware change is required.
HOMEAI_AMBIENT_PREFILL_SEGMENTS=2
HOMEAI_AMBIENT_FADE_IN_SEC=2.0
HOMEAI_AMBIENT_FADE_OUT_SEC=5.0
